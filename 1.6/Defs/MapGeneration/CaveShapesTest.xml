<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shared gen step pipeline. Order in this list is cosmetic - GenerateContentsIntoMap
       sorts by GenStepDef.order, then index. -->
  <CavesFramework.CaveShapeDef Name="CF_CaveShapeBase" Abstract="True">
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>MutatorCriticalStructures</li>
      <li>MutatorNonCriticalStructures</li>
      <li>RockChunks</li>
      <li>PlaceCaveExit</li>
      <li>Plants</li>
      <li>MutatorFinal</li>
      <li>Fog</li>
    </genSteps>
    <customMapComponents>
      <li>CavesFramework.Comps.MapComps.CollapseCaveTimer</li>
    </customMapComponents>
  </CavesFramework.CaveShapeDef>

  <!-- Deliberately extreme aspect ratio: if the map is 50x300 the shape axis worked. -->
  <CavesFramework.CaveShapeDef ParentName="CF_CaveShapeBase">
    <defName>CF_Shape_Long</defName>
    <label>long cave</label>
    <width>50</width>
    <height>300</height>
    <randomizeHeightAndWidth>true</randomizeHeightAndWidth>
  </CavesFramework.CaveShapeDef>

  <!-- Square, so the two shapes are trivially distinguishable in game. -->
  <CavesFramework.CaveShapeDef ParentName="CF_CaveShapeBase">
    <defName>CF_Shape_Average</defName>
    <label>average cave</label>
    <width>150</width>
    <height>150</height>
    <randomizeHeightAndWidth>false</randomizeHeightAndWidth>
  </CavesFramework.CaveShapeDef>

</Defs>

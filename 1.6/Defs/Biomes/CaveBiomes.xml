<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A plain BiomeDef with no CF-specific extension. This is the point of CaveDef owning
       the shape/biome pairing: any vanilla or third-party biome can be used as a cave biome
       without cooperating with this mod. -->
  <BiomeDef ParentName="Biome_Underground">
    <defName>CF_Biome_Test</defName>
    <label>test cave biome</label>
    <description>No cost too great. No mind to think. No will to break. No voice to cry suffering...</description>

    <!-- This is the easiest way to see that the biome applied -->
    <constantOutdoorTemperature>-69</constantOutdoorTemperature>
  </BiomeDef>
</Defs>

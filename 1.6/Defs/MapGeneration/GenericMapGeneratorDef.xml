<Defs>
  <!-- The one registered generator. Every cave clones this at generation time and fills the
       clone in with its real shape/biome/mutators - see CaveMapUtility.BuildMapGeneratorDefFromParts.
       Its defName is save-critical API: Map saves generatorDef by defName, so renaming this
       breaks every existing save. Values here are only the ones the clone does not overwrite,
       plus placeholders that must be non-null for vanilla to survive to the point where we
       swap them. -->
  <MapGeneratorDef>
    <defName>CF_CaveMapGenerator</defName>
    <label>error: CF_CaveMapGenerator label not changed</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>

    <!-- CaveInfo stores what the clone was built from so it can be rebuilt on load.
         It must live here rather than on a CaveShapeDef: shape authors must not be able
         to leave it off. CaveShapeDef.customMapComponents is merged on top of this list. -->
    <customMapComponents>
      <li>CavesFramework.CaveInfo</li>
    </customMapComponents>

    <!-- Never used - the clone always replaces this. It exists because the element itself
         must be non-null (MapGenerator.cs:145 dereferences it) and because map.Biome is read
         by MapComponent constructors before we get a callback. If a cave ever generates with
         this biome, the clone failed and CF_Biome_Error will say so in game. -->
    <pocketMapProperties>
      <biome>CF_Biome_Error</biome>
    </pocketMapProperties>

    <!-- Never used - CaveShapeDef.genSteps replaces this wholesale. Left non-empty only
         so a half-built clone fails visibly rather than generating a blank map. -->
    <genSteps>
      <li>ElevationFertility</li>
    </genSteps>
  </MapGeneratorDef>

  <BiomeDef ParentName="Biome_Underground">
    <defName>CF_Biome_Error</defName>
    <label>oh no</label>
    <description>Hey! if you see this biome, something went horribly wrong its just a placeholder!</description>
    <!-- Absurd on purpose, and deliberately different from CF_Biome_Test's -69, so the
         two are never confused in game. -->
    <constantOutdoorTemperature>200</constantOutdoorTemperature>
  </BiomeDef>
</Defs>

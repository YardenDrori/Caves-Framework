<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       CAVE BIOMES
       Real BiomeDefs. They carry the CaveBiome extension (shape
       filters, genStep overrides, mutators) and are what gets
       assigned to map.pocketTileInfo.PrimaryBiome once the biome
       swap is wired up.

       Inherits Biome_Underground for weather, diseases and the
       no-natural-generation flag.
       ============================================================ -->
  <BiomeDef ParentName="Biome_Underground">
    <defName>CF_Biome_Barren</defName>
    <label>barren cave</label>
    <description>Bare rock and stone. Nothing grows here.</description>
    <modExtensions>
      <li Class="CavesFramework.CaveBiome">
        <!-- both shape lists left null == every shape allowed -->
        <selectionWeight>1</selectionWeight>
      </li>
    </modExtensions>
  </BiomeDef>

</Defs>

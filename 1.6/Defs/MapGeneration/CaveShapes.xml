<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <MapGeneratorDef Name="CF_CaveShapeBase" Abstract="True">
    <isUnderground>true</isUnderground>
    <forceCaves>true</forceCaves>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <customMapComponents>
      <li>CavesFramework.Comps.MapComps.CollapseCaveTimer</li>
    </customMapComponents>
    <pocketMapProperties>
      <biome>Underground</biome>
      <temperature>15</temperature>
      <tileMutators>
        <!-- this is what actually carves the caves for now -->
        <li>UndergroundCave</li>
      </tileMutators>
    </pocketMapProperties>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>MutatorCriticalStructures</li>
      <li>MutatorNonCriticalStructures</li>
      <li>RockChunks</li>
      <li>PlaceCaveExit</li>
      <li>Plants</li>
      <li>MutatorFinal</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="CF_CaveShapeBase">
    <defName>CF_Shape_Long</defName>
    <label>long cave</label>
    <modExtensions>
      <li Class="CavesFramework.CaveShape">
        <mapWidth>50</mapWidth>
        <mapHeight>300</mapHeight>
        <selectionWeight>1</selectionWeight>
      </li>
    </modExtensions>
  </MapGeneratorDef>

